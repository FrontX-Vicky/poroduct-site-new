# Copy to backend/.env and change values as needed:  cp .env.example .env
# backend/.env is ignored by git. Real environment variables override this file.

# Database connection. Leave empty to use database/shop.db in the project root.
# Use an absolute path if you set it, e.g. sqlite:////absolute/path/to/shop.db
DATABASE_URL=

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# How long a login session stays valid, in hours
SESSION_TTL_HOURS=12

# Demo account created by `python -m app.seed` (dummy values - change them)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
